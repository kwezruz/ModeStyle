rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'davroncaiman09@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
    }

    // User profiles
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // Orders
    match /orders/{orderId} {
      allow get: if (isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin())) || !isSignedIn();
      allow list: if (isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin())) || isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }
  }
}
